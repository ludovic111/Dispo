<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Copiez ce fichier en « Secrets.plist » (gitignoré) et remplissez.
	     Dev local :  supabase start  puis  supabase status
	       SUPABASE_URL      = http://IP-DU-MAC:54321  (même Wi-Fi que l'iPhone)
	       SUPABASE_ANON_KEY = la valeur « anon key »
	     Sans ce fichier, l'app tourne en mode démo local. -->
	<key>SUPABASE_URL</key>
	<string>http://192.168.1.XXX:54321</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>VOTRE_ANON_KEY</string>
</dict>
</plist>
