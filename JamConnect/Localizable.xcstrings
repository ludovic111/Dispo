    "Aperçu visuel seulement : tes droits réels (Premium, annonces débloquées côté serveur) restent inchangés.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur visuelle Vorschau: deine echten Rechte (Premium, serverseitige Freischaltungen) bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visual preview only: your real entitlements (Premium, server-side unlocks) stay unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo vista previa: tus permisos reales (Premium, desbloqueos del servidor) no cambian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo anteprima visiva: i tuoi diritti reali (Premium, sblocchi lato server) restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示のみのプレビューです。実際の権限（Premium、サーバー側の解放）は変わりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅为视觉预览：你的真实权限（Premium、服务端解锁）保持不变。"
          }
        }
      }
    },
