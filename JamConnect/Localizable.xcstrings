    "En continuant, tu acceptes que ton profil soit visible des autres musiciens.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du fortfährst, ist dein Profil für andere Musiker sichtbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By continuing, you agree that your profile is visible to other musicians."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al continuar, aceptas que tu perfil sea visible para otros músicos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuando accetti che il tuo profilo sia visibile agli altri musicisti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続行すると、プロフィールが他のミュージシャンに公開されることに同意したことになります。"
