    "Messages d'équipe, partitions partagées, agenda des concerts — et SOS pré-rempli si un membre lâche.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Team-Nachrichten, geteilte Noten, Gig-Kalender — und ein vorausgefülltes SOS, wenn jemand absagt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Team messages, shared sheet music, gig agenda — and a pre-filled SOS if a member bails."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensajes de equipo, partituras compartidas, agenda de bolos — y SOS prellenado si un miembro falla."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Messaggi di gruppo, spartiti condivisi, agenda dei concerti — e SOS precompilato se un membro molla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チーム連絡・楽譜共有・ライブ日程、メンバーが抜けたら事前入力SOSも。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "队内消息、共享乐谱、演出日程——成员放鸽子还有预填SOS。"
          }
        }
      }
    },
