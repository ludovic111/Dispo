    "Mets un cœur aux musiciens fiables pour les retrouver ici en un tap.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib zuverlässigen Musikern ein Herz, um sie hier mit einem Tipp zu finden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart reliable musicians to find them here in one tap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da un corazón a los músicos fiables para encontrarlos aquí en un toque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti un cuore ai musicisti affidabili per ritrovarli qui con un tap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頼れるミュージシャンにハートを。ワンタップでここから開けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
