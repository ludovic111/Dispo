    "Un compte existe déjà avec cet e-mail — connecte-toi.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dieser E-Mail existiert bereits ein Konto — melde dich an."
          }
        },
        "en": {
