    "Tout le monde est trouvable — même sans géoloc, sans instruments ou indisponible": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle sind auffindbar — auch ohne Standort, Instrumente oder Verfügbarkeit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone is findable — even without location, instruments or availability"
          }
