    "Ajoute les dates du groupe — et si un membre lâche, publie un SOS pré-rempli en un tap.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag die Termine der Band ein — und wenn jemand absagt, poste mit einem Tipp ein vorausgefülltes SOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the band's dates — and if a member bails, post a pre-filled SOS in one tap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade las fechas de la banda — y si un miembro falla, publica un SOS prellenado en un toque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi le date della band — e se un membro molla, pubblica un SOS precompilato con un tap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バンドの日程を登録。メンバーが抜けたらワンタップで事前入力済みSOSを投稿。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加乐队日程——如有成员放鸽子，一键发布预填好的SOS。"
          }
        }
      }
    },
