{
  "expo": {
    "name": "Dispo",
    "slug": "dispo",
    "version": "2.4",
    "orientation": "portrait",
    "icon": "./assets/images/dispo/app-icon.png",
    "scheme": "dispo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ch.dispo.app",
      "buildNumber": "43",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Dispo utilise ta position approximative pour trouver des musiciens et des SOS près de toi.",
        "NSPhotoLibraryUsageDescription": "Dispo accède aux photos et vidéos que tu choisis pour ton profil et tes messages."
      },
      "appleTeamId": "2YBQQ56HH8"
    },
    "android": {
      "package": "ch.dispo.app",
      "versionCode": 43,
      "adaptiveIcon": {
        "backgroundColor": "#050814",
        "foregroundImage": "./assets/images/dispo/app-icon.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/dispo/app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050814",
          "image": "./assets/images/dispo/logo-mark.png",
          "imageWidth": 112,
          "dark": {
            "backgroundColor": "#050814",
            "image": "./assets/images/dispo/logo-mark.png"
          }
        }
      ],
      "expo-localization",
      "expo-image-picker",
      "expo-sharing",
      "expo-video",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
