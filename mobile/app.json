    "android": {
      "package": "ch.dispo.app",
      "versionCode": 56,
      "adaptiveIcon": {
        "backgroundColor": "#050814",
        "foregroundImage": "./assets/images/dispo/app-icon.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/dispo/app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050814",
          "image": "./assets/images/dispo/logo-mark.png",
          "imageWidth": 112,
          "dark": {
            "backgroundColor": "#050814",
            "image": "./assets/images/dispo/logo-mark.png"
          }
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Dispo accède aux photos et vidéos que tu choisis pour ton profil et tes messages.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-video",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Dispo utilise ta position uniquement à ta demande pour les distances et la recherche à proximité. Tu choisis la précision partagée dans les réglages.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "Dispo n’utilise pas tes données de mouvement ou d’activité physique. Tu peux refuser cet accès.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isAndroidMotionActivityEnabled": false
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
