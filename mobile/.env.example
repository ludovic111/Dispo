# Public client values only. Never add the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# Optional build-time key for the embedded Android map. Restrict it to the
# Android app/package in Google Cloud. Never commit a real value.
GOOGLE_MAPS_ANDROID_API_KEY=your_restricted_android_maps_key
