# Copie ce fichier vers local.properties, puis complète uniquement les valeurs publiques client.
# Ne mets jamais de service_role, de secret key ou de mot de passe de base de données dans l'app.
sdk.dir=C\:\\Users\\YOUR_NAME\\AppData\\Local\\Android\\Sdk
# Laisse ces valeurs vides pour la démo hors ligne.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
