    },
    "Personne ne matche pour l'instant. Dès qu'un musicien compatible coche le %@ dans son calendrier, il apparaîtra ici.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Treffer. Sobald ein passender Musiker den %@ in seinem Kalender ankreuzt, erscheint er hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No matches yet. As soon as a matching musician marks %@ in their calendar, they'll show up here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie coincide por ahora. En cuanto un músico compatible marque el %@ en su calendario, aparecerá aquí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun match per ora. Appena un musicista compatibile segna il %@ nel calendario, apparirà qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだマッチしていません。条件の合うミュージシャンがカレンダーで%@をチェックすると、ここに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无匹配。一旦有匹配的音乐人在日历中勾选%@，就会显示在这里。"
          }
        }
      }
    },
    "Personne pour l'instant — reviens en fin d'après-midi.": {
      "localizations": {
