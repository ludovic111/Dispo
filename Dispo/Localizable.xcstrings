    "Concert, répé ou jam : chaque événement a sa setlist — et si un membre lâche, SOS pré-rempli en un tap.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gig, Probe oder Jam: jedes Event hat seine Setlist — und wenn jemand absagt, ein vorausgefülltes SOS mit einem Tipp."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gig, rehearsal or jam: every event has its setlist — and if a member bails, a pre-filled SOS in one tap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bolo, ensayo o jam: cada evento tiene su setlist — y si un miembro falla, SOS prellenado en un toque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concerto, prova o jam: ogni evento ha la sua scaletta — e se un membro molla, SOS precompilato con un tap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ・リハ・ジャム：各イベントにセットリスト。メンバーが抜けたらワンタップでSOS。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "演出、排练或即兴：每场活动都有setlist——成员放鸽子时一键预填SOS。"
          }
        }
      }
    },
