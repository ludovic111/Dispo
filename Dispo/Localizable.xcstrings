    "Merci de tester ! Un pépin, une idée ? Dis-le à Ludovic.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke fürs Testen! Ein Bug, eine Idee? Sag's Ludovic."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanks for testing! Found a bug, got an idea? Tell Ludovic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Gracias por probar! ¿Un fallo, una idea? Díselo a Ludovic."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie per i test! Un problema, un'idea? Dillo a Ludovic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テストありがとう！不具合やアイデアはLudovicまで。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感谢测试！有问题或想法？告诉Ludovic。"
          }
        }
      }
    },
    "Merci de tester ! Un pépin, une idée ? Écris-nous via l'assistance dispoapp.net.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke fürs Testen! Ein Problem, eine Idee? Schreib uns über den Support auf dispoapp.net."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanks for testing! A glitch, an idea? Write to us via support at dispoapp.net."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Gracias por probar! ¿Un fallo, una idea? Escríbenos a través de la asistencia en dispoapp.net."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie per il test! Un problema, un'idea? Scrivici tramite l'assistenza su dispoapp.net."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テストありがとうございます！不具合やアイデアがあれば、dispoapp.netのサポートまでご連絡ください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感谢测试！有问题或建议？请通过dispoapp.net的支持页面联系我们。"
          }
        }
      }
    },
