    "Note les musiciens avec qui tu as joué : 1 à 5 étoiles, note anonyme — seule la moyenne et le nombre d'avis s'affichent": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewerte Musiker, mit denen du gespielt hast: 1 bis 5 Sterne, anonym — nur Durchschnitt und Anzahl werden angezeigt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate the musicians you've played with: 1 to 5 stars, anonymously — only the average and review count are shown"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valora a los músicos con los que has tocado: de 1 a 5 estrellas, de forma anónima — solo se muestran la media y el número de reseñas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valuta i musicisti con cui hai suonato: da 1 a 5 stelle, in anonimo — si vedono solo media e numero di recensioni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共演したミュージシャンを1〜5つ星で匿名評価 — 表示されるのは平均と件数だけ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为合作过的乐手打 1–5 星，匿名评分 — 只显示平均分和评价数"
          }
        }
      }
    },
