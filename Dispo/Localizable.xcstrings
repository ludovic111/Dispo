          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The link shared by the band is removed. The chord grid and the key stay put."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quita el enlace compartido por el grupo. La parrilla de acordes y la tonalidad se mantienen."
          }
        },
        "it" : {
          "stringUnit" : {
