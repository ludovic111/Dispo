          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each choice controls banners, the in-app notification center, and the red badge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada opción controla los banners, el centro de notificaciones de la app y la insignia roja."
          }
        },
        "it" : {
          "stringUnit" : {
