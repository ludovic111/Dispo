    },
    "Le bouton « Lier mon compte Apple » apparaît maintenant sur TestFlight et l'App Store": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Button „Apple-Konto verknüpfen“ erscheint jetzt auch in TestFlight- und App-Store-Builds"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The “Link my Apple account” button now appears on TestFlight and App Store builds"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón «Vincular mi cuenta de Apple» ahora aparece en TestFlight y App Store"
          }
        },
        "it": {
