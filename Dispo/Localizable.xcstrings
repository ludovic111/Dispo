    "Ajoute des vidéos de démo à ton profil. On entend le niveau et le style — zéro mauvaise surprise.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge deinem Profil Demo-Videos hinzu. Man hört Niveau und Stil — keine bösen Überraschungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add demo videos to your profile. People hear your level and style — no bad surprises."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade vídeos de demo a tu perfil. Se escucha tu nivel y tu estilo: cero sorpresas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi video demo al tuo profilo. Si sentono livello e stile: zero brutte sorprese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィールにデモ動画を追加しましょう。レベルとスタイルが伝わり、ミスマッチを防げます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在资料中添加演示视频。让人听到你的水平和风格——零意外。"
          }
        }
      }
    },
    "Ajoute les morceaux du groupe — les membres peuvent en suggérer, le leader valide.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge die Songs der Gruppe hinzu — Mitglieder schlagen vor, der Leader bestätigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the group's songs — members can suggest, the leader approves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade los temas del grupo — los miembros sugieren, el líder valida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi i brani del gruppo — i membri suggeriscono, il leader approva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループの曲を追加。メンバーが提案し、リーダーが承認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加群组曲目——成员可以建议，队长审核。"
          }
        }
      }
    },
