    "Tout le monde est là — le concert peut se jouer." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle sind da – das Konzert kann stattfinden."
          }
