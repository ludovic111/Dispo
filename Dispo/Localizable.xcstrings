    "Accueil : « Ce soir » devient « Aujourd'hui » — c'est la journée entière qui compte, pas la soirée" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start: „Heute Abend“ wird zu „Heute“ — es zählt der ganze Tag, nicht nur der Abend"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home: “Tonight” becomes “Today” — the whole day counts, not just the evening"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicio: «Esta noche» pasa a ser «Hoy»: cuenta el día entero, no solo la noche"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home: «Stasera» diventa «Oggi»: conta l'intera giornata, non solo la sera"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホーム：「今夜」が「今日」になりました。夜だけでなく一日全体が対象です"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首页：「今晚」改为「今天」— 算的是一整天，而不只是晚上"
          }
        }
      }
    },
    "Accueil : « Ce soir », « Ce week-end », « Près de chez toi » — on répond d'abord à qui peut jouer, et quand" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startseite: „Heute Abend“, „Dieses Wochenende“, „In deiner Nähe“ – zuerst zählt, wer wann spielen kann"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home: “Tonight”, “This weekend”, “Near you” — who can play, and when, comes first"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicio: «Esta noche», «Este finde», «Cerca de ti»: primero quién puede tocar y cuándo"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home: «Stasera», «Questo weekend», «Vicino a te» — prima chi può suonare, e quando"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホーム:「今夜」「今週末」「近く」— 誰がいつ演奏できるかを最優先"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首页：「今晚」「本周末」「你附近」——先回答谁能演出、什么时候"
          }
        }
      }
    },
