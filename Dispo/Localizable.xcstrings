    "Le leader choisit dans le groupe s'il est public (visible sur vos profils) ou privé.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Leader legt in der Gruppe fest, ob sie öffentlich (auf euren Profilen sichtbar) oder privat ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The leader chooses in the group whether it's public (shown on your profiles) or private."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El líder decide en el grupo si es público (visible en vuestros perfiles) o privado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il leader sceglie nel gruppo se renderlo pubblico (visibile sui vostri profili) o privato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループが公開（プロフィールに表示）か非公開かはリーダーがグループ内で選びます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由队长在乐队内选择公开（显示在你们的资料上）或私密。"
          }
        }
      }
    },
    "Le leader peut renommer son groupe à tout moment": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Leader kann die Gruppe jederzeit umbenennen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The leader can rename the group at any time"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El líder puede renombrar el grupo en cualquier momento"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il leader può rinominare il gruppo in qualsiasi momento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リーダーはいつでもグループ名を変更できます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "组长可以随时重命名小组"
          }
        }
      }
    },
    "Le leader sera alerté 2 jours avant pour trouver un remplaçant.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Leader wird 2 Tage vorher benachrichtigt, um Ersatz zu finden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The leader will be alerted 2 days before to find a replacement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El líder recibirá un aviso 2 días antes para encontrar un sustituto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il leader sarà avvisato 2 giorni prima per trovare un sostituto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リーダーには2日前に通知され、代役を探せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "队长将提前2天收到提醒，以便寻找替补。"
          }
        }
      }
    },
    "Le leadership ne peut être transmis qu'à un membre Premium.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Leitung kann nur an ein Premium-Mitglied übergeben werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leadership can only be transferred to a Premium member."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El liderazgo solo puede transferirse a un miembro Premium."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La leadership può passare solo a un membro Premium."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リーダーはPremiumメンバーにのみ引き継げます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "队长身份只能转让给Premium成员。"
          }
        }
      }
    },
    "Le leadership ne peut être transmis qu'à un membre Premium. Marque chaque membre Permanent (noyau) ou Occasionnel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Leitung kann nur an ein Premium-Mitglied übergeben werden. Markiere jedes Mitglied als Permanent (Kern) oder Gelegentlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leadership can only be passed to a Premium member. Mark each member Permanent (core) or Occasional."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El liderazgo solo puede transferirse a un miembro Premium. Marca a cada miembro como Permanente (núcleo) u Ocasional."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La leadership può passare solo a un membro Premium. Segna ogni membro come Permanente (nucleo) oppure Occasionale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リーダー権限はPremiumメンバーにのみ譲渡できます。各メンバーを常任（コア）または臨時に設定しましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "队长身份只能转让给Premium成员。请将每位成员标记为常驻（核心）或临时。"
          }
        }
      }
    },
    "Le message n'a pas pu être envoyé.": {
