    "Écris les accords en lettres (C, Bb, F#m7…). Dispo les transpose tout seul pour chaque instrument — la mise en page et les barres de mesure sont conservées." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreib die Akkorde in Buchstaben (C, Bb, F#m7…). Dispo transponiert sie für jedes Instrument — Layout und Taktstriche bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write chords in letters (C, Bb, F#m7…). Dispo transposes them for every instrument — layout and bar lines are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe los acordes en letras (C, Bb, F#m7…). Dispo los transpone para cada instrumento y respeta el formato y los compases."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi gli accordi in lettere (C, Bb, F#m7…). Dispo li traspone per ogni strumento e conserva impaginazione e battute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コードは英字で入力します（C、Bb、F#m7 など）。Dispo が楽器ごとに移調し、レイアウトと小節線はそのまま保ちます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用字母写和弦（C、Bb、F#m7…）。Dispo 会为每件乐器移调，并保留排版和小节线。"
          }
        }
      }
    },
