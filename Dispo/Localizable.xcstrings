          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The new time, title and venue carry over to the upcoming dates. The days of the series themselves don't change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nuevo horario, el título y el lugar se aplican a las fechas futuras. Los días de la serie no cambian."
