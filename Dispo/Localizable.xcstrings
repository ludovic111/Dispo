          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only this date moves. The other rehearsals keep their time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se mueve esta fecha. Los demás ensayos mantienen su horario."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sposta solo questa data. Le altre prove mantengono il loro orario."
          }
