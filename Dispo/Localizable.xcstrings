    },
    "La grille s'ouvre dans iReal Pro, l'app de play-along des musiciens. Sans elle, la grille reste lisible ici et se copie d'un tap." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Raster öffnet sich in iReal Pro, der Play-along-App der Musiker. Ohne sie bleibt das Raster hier lesbar und lässt sich mit einem Tipp kopieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The chart opens in iReal Pro, the musicians' play-along app. Without it, the chart stays readable here and copies in one tap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuadrícula se abre en iReal Pro, la app de play-along de los músicos. Sin ella, la cuadrícula sigue siendo legible aquí y se copia con un toque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La griglia si apre in iReal Pro, l'app di play-along dei musicisti. Senza, la griglia resta leggibile qui e si copia con un tocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コード譜はミュージシャン向けの伴奏アプリ iReal Pro で開きます。なくてもここで読めますし、ワンタップでコピーできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和弦谱会在乐手常用的伴奏应用 iReal Pro 中打开。没有它，谱面在这里依然可读，一键即可复制。"
          }
        }
      }
    },
    "La liaison avec Apple a échoué — réessaie." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verknüpfung mit Apple ist fehlgeschlagen — versuch es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linking with Apple failed — try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vinculación con Apple falló: inténtalo de nuevo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il collegamento con Apple non è riuscito: riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleとのリンクに失敗しました。もう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与Apple关联失败——请重试。"
          }
        }
      }
    },
    "La messagerie charge un historique borné, évite les notifications en double et ne mélange plus les caches entre comptes" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nachrichtenansicht lädt einen begrenzten Verlauf, verhindert doppelte Mitteilungen und trennt Caches zwischen Konten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Messaging loads a bounded history, avoids duplicate notifications, and no longer mixes caches between accounts"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mensajería carga un historial limitado, evita notificaciones duplicadas y ya no mezcla cachés entre cuentas"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La messaggistica carica una cronologia limitata, evita notifiche duplicate e non mescola più le cache tra account"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージ履歴を適切な件数に制限し、通知の重複とアカウント間のキャッシュ混在を防ぎます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "消息仅加载有限历史记录，避免重复通知，也不再混用不同账号的缓存"
          }
        }
      }
    },
