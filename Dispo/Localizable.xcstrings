            "state": "translated",
            "value": "Vídeo demasiado pesado — recórtalo e inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Video troppo pesante — accorcialo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画が大きすぎます — 短くしてもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频太大 — 请剪短后重试。"
          }
        }
      }
    },
    "Vidéos de démo : titre, miniatures et son même en mode silencieux": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo-Videos: Titel, Vorschaubilder und Ton auch im Lautlos-Modus"
