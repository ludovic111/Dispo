    "Ces musiciens jouent l'instrument que tu cherches et sont dispo le %@. Contacte-les sans attendre.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Musiker spielen das gesuchte Instrument und sind am %@ frei. Kontaktiere sie direkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These musicians play the instrument you need and are free on %@. Reach out right away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos músicos tocan el instrumento que buscas y están libres el %@. Contáctalos sin esperar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi musicisti suonano lo strumento che cerchi e sono liberi il %@. Contattali subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人たちは募集パートを演奏でき、%@に空いています。すぐ連絡しましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些音乐人会你需要的乐器，且%@有空。马上联系他们吧。"
          }
        }
      }
    },
    "Cette date ou toute la série ?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Termin oder die ganze Reihe?"
          }
        },
        "en": {
