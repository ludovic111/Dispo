        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기간 동안, 음악가와 밴드는이 도시에 당신을 찾아 자신의 연구에서 — 당신의 가정에서."
          }
        }
      }
    },
