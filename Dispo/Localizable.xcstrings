    "Tes concerts de groupe, les dépannages qu'on te confie, tes candidatures et les SOS que tu publies apparaissent ici." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier erscheinen die Termine deiner Bands, die Einsätze, um die man dich bittet, deine Bewerbungen und die SOS, die du veröffentlichst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your band dates, the fill-ins you're asked to cover, your applications and the SOS you post all show up here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecen los conciertos de tus grupos, las sustituciones que te piden, tus candidaturas y los SOS que publicas."
          }
