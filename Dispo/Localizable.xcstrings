    "Seul le leader crée les événements — suggère-lui en message." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur der Leader erstellt Events — schlag ihm per Nachricht vor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
