    "C'est ce que les organisateurs regardent avant de t'engager — 60 à 90 secondes suffisent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das schauen sich Veranstalter an, bevor sie dich buchen — 60 bis 90 Sekunden reichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is what organizers watch before hiring you — 60 to 90 seconds is plenty."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es lo que miran los organizadores antes de contratarte — con 60–90 segundos basta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È ciò che gli organizzatori guardano prima di ingaggiarti — bastano 60–90 secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "主催者は依頼前にこれを観ます。60〜90秒で十分。"
