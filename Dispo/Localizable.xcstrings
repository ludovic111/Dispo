    },
    "Le cachet d'un SOS se découvre en ouvrant l'annonce — avec une option « Sans cachet »": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gage eines SOS zeigt sich beim Öffnen der Anzeige — mit der Option „Ohne Gage“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An SOS fee is revealed when opening the listing — with a “No fee” option"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El caché de un SOS se descubre al abrir el anuncio, con una opción «Sin caché»"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cachet di un SOS si scopre aprendo l'annuncio — con l'opzione «Senza cachet»"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SOSのギャラは告知を開くと表示 — 「ギャラなし」オプションも追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SOS 酬劳在打开告示时才显示 — 并新增「无酬劳」选项"
          }
        }
      }
    },
    "Le cachet reste discret : il ne s'affiche qu'en ouvrant le SOS.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gage bleibt diskret: Sie erscheint erst beim Öffnen des SOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fee stays discreet: it only shows when opening the SOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El caché es discreto: solo se muestra al abrir el SOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cachet resta discreto: appare solo aprendo il SOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ギャラは控えめに — SOSを開いたときだけ表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "酬劳保持低调：只有打开 SOS 时才会显示。"
          }
        }
