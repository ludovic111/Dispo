    "Setlist vide — pioche dans le répertoire du groupe ou ajoute des morceaux." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leere Setlist — bedien dich am Repertoire oder füge Songs hinzu."
          }
        },
