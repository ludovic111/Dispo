    "Public : le groupe apparaît sur les profils de ses membres (nom, photo, effectif). Privé : il reste entre vous.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffentlich: Die Gruppe erscheint auf den Profilen ihrer Mitglieder (Name, Foto, Größe). Privat: Sie bleibt unter euch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public: the group appears on its members' profiles (name, photo, size). Private: it stays between you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Público: el grupo aparece en los perfiles de sus miembros (nombre, foto, tamaño). Privado: queda entre vosotros."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pubblico: il gruppo appare sui profili dei membri (nome, foto, numero). Privato: resta tra di voi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開：グループ（名前・写真・人数）がメンバーのプロフィールに表示されます。非公開：メンバーだけのものになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公开：乐队（名称、照片、人数）会显示在成员的资料上。私密：只属于你们。"
          }
        }
      }
    },
