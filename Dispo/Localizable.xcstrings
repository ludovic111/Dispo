    "Entre le code postal. Avec une date, Dispo cherche aussi les musiciens qui seront en séjour sur place." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib die Postleitzahl ein. Mit einem Datum findet Dispo auch Musiker, die dann vor Ort sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the postal code. With a date, Dispo also finds musicians staying there then."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce el código postal. Con una fecha, Dispo también busca músicos que estarán allí."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci il codice postale. Con una data, Dispo cerca anche chi sarà lì in quel periodo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "郵便番号を入力してください。日付を指定すると、その日に滞在しているミュージシャンも探します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入邮政编码。选择日期后，Dispo 也会寻找届时住在当地的音乐人。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre o código postal. Com data, a Dispo também está à procura de músicos que vão ficar no local."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "우편 번호 사이에. 날짜로, Dispo는 또한 사이트에 머물 수있는 음악가를 찾고 있습니다."
          }
        }
      }
    },
