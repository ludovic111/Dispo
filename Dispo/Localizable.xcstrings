    "Un appui long permet de réagir, modifier ton texte ou supprimer ton message pour tout le monde" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch langes Drücken kannst du reagieren, deinen Text bearbeiten oder die Nachricht für alle löschen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long-press to react, edit your text, or delete your message for everyone"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado para reaccionar, editar tu texto o eliminar tu mensaje para todos"
