    "Choisis le jour où tu as besoin d'un musicien — seuls ceux qui l'ont coché dans leur calendrier restent affichés." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle den Tag, an dem du einen Musiker brauchst — nur wer ihn im Kalender angekreuzt hat, bleibt sichtbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick the day you need a musician — only those who ticked it in their calendar stay visible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el día en que necesitas un músico: solo se muestran quienes lo marcaron en su calendario."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli il giorno in cui ti serve un musicista: restano visibili solo quelli che l'hanno spuntato nel calendario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミュージシャンが必要な日を選んでください。カレンダーでその日をチェックした人だけが表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择你需要音乐人的日期——只显示在日历中勾选了该日期的人。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha o dia em que você precisa de um músico — apenas os que o verificaram em seu calendário permanecem em exposição."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음악가가가 필요한 날을 선택하십시오. 그들의 달력에 체크한 사람만 디스플레이에 남아 있습니다."
          }
        }
      }
    },
    "Choisis le répertoire de destination. La tonalité et la grille sont copiées ; les solos restent propres à chaque groupe." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle das Zielrepertoire. Tonart und Akkordschema werden kopiert; die Soli bleiben gruppenspezifisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the destination repertoire. The key and chord chart are copied; solos stay specific to each group."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el repertorio de destino. Se copiarán la tonalidad y la parrilla; los solos seguirán siendo propios de cada grupo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli il repertorio di destinazione. Tonalità e griglia vengono copiate; i soli restano specifici di ogni gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピー先のレパートリーを選んでください。キーとコード譜はコピーされますが、ソロは各グループで個別に管理されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择目标曲库。调性与和弦谱会一并复制；独奏安排仍由各群组单独管理。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha o diretório de destino. O tom e a grade são copiados; solos permanecem únicos para cada grupo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대상 디렉토리를 선택하십시오. 톤과 그리드는 복사; 솔로는 각 그룹에 독특합니다."
          }
        }
      }
    },
    "Choisis seulement les alertes utiles. Elles arrivent sur l'iPhone, dans la cloche de l'app et dans la puce de l'icône." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle nur die wichtigen Hinweise. Sie erscheinen auf dem iPhone, in der App-Glocke und auf dem App-Symbol."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose only the alerts you need. They appear on your iPhone, under the in-app bell, and on the app icon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige solo las alertas útiles. Aparecen en el iPhone, en la campana de la app y en el icono."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli solo gli avvisi utili. Arrivano sull'iPhone, nella campana dell'app e sull'icona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要な通知だけを選べます。iPhone、アプリ内のベル、アプリアイコンに表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只选择需要的提醒。它们会显示在 iPhone、应用内铃铛和应用图标上。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione apenas alertas úteis. Eles chegam no iPhone, no sino do aplicativo e no chip de ícone."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유용한 경고를 선택하십시오. 그들은 아이폰에 도착, 앱 벨과 아이콘 칩에."
          }
        }
      }
    },
    "Choisis seulement les alertes utiles. Un appui sur une notification ouvre directement la bonne conversation ou le bon SOS." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle nur die nützlichen Hinweise. Ein Tipp auf eine Mitteilung öffnet direkt die richtige Unterhaltung oder das richtige SOS."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick only the alerts you need. Tapping a notification opens the right conversation or SOS directly."
          }
