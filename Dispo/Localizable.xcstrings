    },
    "Les musiciens qui ont joué avec %@ — un tap ouvre leur profil.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Musiker, die mit %@ gespielt haben — ein Tipp öffnet ihr Profil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The musicians who have played with %@ — tap to open their profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los músicos que han tocado con %@: toca para abrir su perfil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I musicisti che hanno suonato con %@ — un tocco apre il loro profilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@と共演したミュージシャン — タップでプロフィールを開けます。"
          }
        },
