    "Tu t'es trompé·e ? Libère le poste : l'annonce se rouvre et le candidat repasse en attente" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertan? Gib die Position frei: Die Anzeige öffnet sich wieder und der Kandidat wartet erneut"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Made a mistake? Free up the slot: the listing reopens and the candidate goes back to pending"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Te equivocaste? Libera el puesto: el anuncio se reabre y el candidato vuelve a estar en espera"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
