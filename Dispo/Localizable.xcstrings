        }
      }
    },
    "La tonalité s'affiche sous le titre. La pochette est récupérée automatiquement si le morceau est trouvé." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Tonart erscheint unter dem Titel. Das Cover wird automatisch geladen, wenn der Song gefunden wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The key appears below the title. Artwork is fetched automatically when the song is found."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tonalidad aparece debajo del título. La portada se obtiene automáticamente si se encuentra la canción."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tonalità appare sotto il titolo. La copertina viene recuperata automaticamente se il brano viene trovato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーは曲名の下に表示されます。曲が見つかるとジャケットが自動で取得されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调性会显示在标题下方。找到歌曲后会自动获取封面。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tom aparece sob o título. A bolsa é recuperada automaticamente se a peça for encontrada."
