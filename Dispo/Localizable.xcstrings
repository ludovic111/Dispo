      }
    },
    "Ta photo de profil part enfin sur le serveur — et les anciennes sont rattrapées toutes seules" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Profilbild landet endlich auf dem Server — ältere werden von selbst nachgeladen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your profile photo finally reaches the server — and older ones are re-uploaded on their own"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu foto de perfil por fin llega al servidor, y las antiguas se recuperan solas"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua foto profilo arriva finalmente sul server, e quelle vecchie si recuperano da sole"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロフィール写真がようやくサーバーへ。以前の写真も自動で再アップロードされます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
