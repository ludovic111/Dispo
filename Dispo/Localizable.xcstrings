    },
    "Le paiement est confirmé. Dispo synchronise maintenant tes droits sécurisés avec le serveur." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Zahlung ist bestätigt. Dispo synchronisiert jetzt deine gesicherten Rechte mit dem Server." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Payment confirmed. Dispo is now syncing your secure access with the server." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Pago confirmado. Dispo está sincronizando tus derechos protegidos con el servidor." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Pagamento confermato. Dispo sta sincronizzando i tuoi diritti protetti con il server." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "支払いが確認されました。Dispoが保護された利用権をサーバーと同期しています。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "付款已确认。Dispo正在与服务器同步你的安全权益。" } }
      }
    },
    "Le pays est détecté automatiquement : entre ton code postal et la ville se remplit toute seule" : {
