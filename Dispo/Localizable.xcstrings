          }
        }
      }
    },
    "Le profil, les messages, les SOS et les relations seront supprimés. Cette action est irréversible.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profile, messages, SOS posts and relationships will be deleted. This cannot be undone."
          }
        }
      }
    },
    "Le rayon s'applique aux musiciens dont la position est connue — les autres restent affichés.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Radius gilt für Musiker mit bekannter Position — die anderen bleiben sichtbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The radius applies to musicians whose position is known — the others stay visible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El radio se aplica a los músicos cuya posición se conoce; los demás siguen visibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il raggio si applica ai musicisti con posizione nota: gli altri restano visibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半径は位置がわかっているミュージシャンに適用されます。その他の人は引き続き表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "半径仅适用于位置已知的音乐人——其他人仍会显示。"
          }
        }
      }
    },
    "Le rouge est désormais réservé aux SOS : le reste de l'app se lit d'un coup d'œil": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rot ist jetzt den SOS vorbehalten — der Rest der App liest sich auf einen Blick"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Red is now reserved for SOS — the rest of the app reads at a glance"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El rojo queda reservado para los SOS: el resto de la app se lee de un vistazo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rosso ora è riservato agli SOS: il resto dell'app si legge a colpo d'occhio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "赤はSOS専用に。それ以外はひと目で読み取れます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "红色现在只属于 SOS：应用其余部分一目了然"
