    "Pendant cette période, les musiciens et les groupes de cette ville te trouvent dans leurs recherches — pas ceux de chez toi." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In diesem Zeitraum finden dich Musikerinnen und Bands dieser Stadt — nicht die von zu Hause."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "During that period, musicians and bands in that city find you in their searches — not the ones back home."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante ese periodo te encuentran los músicos y grupos de esa ciudad, no los de tu zona."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In quel periodo ti trovano i musicisti e i gruppi di quella città, non quelli di casa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その期間は、その街のミュージシャンやバンドの検索に表示されます（地元の人には表示されません）。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
