    "Le SOS s'affiche « Sans cachet » — parfait pour une jam ou un concert bénévole.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der SOS wird als „Ohne Gage“ angezeigt — perfekt für eine Jam oder ein Benefizkonzert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SOS shows as “No fee” — perfect for a jam or a benefit gig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El SOS se muestra como «Sin caché»: perfecto para una jam o un concierto benéfico."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il SOS appare come «Senza cachet» — perfetto per una jam o un concerto benefico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SOSは「ギャラなし」と表示されます — ジャムやチャリティ演奏にぴったり。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SOS 将显示为「无酬劳」— 适合即兴演奏或公益演出。"
          }
        }
      }
    },
    "Le blocage n'a pas pu etre applique.": {
