        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Te falla un músico? Publica tu SOS con el botón +."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un musicista ti ha dato buca? Pubblica il tuo SOS con il pulsante +."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミュージシャンに穴をあけられた？+ボタンからSOSを投稿しましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有音乐人放你鸽子？点击+按钮发布SOS。"
          }
        }
      }
    },
    "Un musicien te lâche ? Trouve un remplaçant fiable en quelques minutes à Genève.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Musiker springt ab? Finde in Minuten einen zuverlässigen Ersatz in Genf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A musician bailed on you? Find a reliable sub in minutes in Geneva."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Un músico te falla? Encuentra un reemplazo fiable en minutos en Ginebra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un musicista ti molla? Trova un sostituto affidabile in pochi minuti a Ginevra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メンバーが急にキャンセル？ジュネーブで数分で頼れる代役を。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "乐手临时放鸽子？在日内瓦几分钟内找到可靠替补。"
          }
        }
      }
    },
    "Un rappel te sera envoyé pour confirmer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du erhältst eine Erinnerung zur Bestätigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll get a reminder to confirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibirás un recordatorio para confirmar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riceverai un promemoria per confermare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認のリマインダーが届きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你会收到确认提醒。"
          }
        }
      }
    },
    "Un seul concert dépanné (CHF 100–300) rembourse **ton année entière** d'abonnement — dès le premier cachet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einziger Einsatz (CHF 100–300) zahlt **dein ganzes Jahr** — ab der ersten Gage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single covered gig (CHF 100–300) pays for **your entire year** — from the very first fee."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo bolo cubierto (100–300 CHF) paga **tu año entero** — desde el primer caché."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sola sostituzione (100–300 CHF) ripaga **il tuo intero anno** — dal primo compenso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回の代役（CHF 100–300）で**年間分を回収**。最初のギャラで元が取れます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只要救场一次（100–300瑞郎），第一笔酬劳就**赚回全年**订阅。"
          }
        }
      }
    },
    "Un seul concert dépanné (souvent CHF 100–300 à Genève) **peut couvrir ton abonnement à l'année**.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einziger übernommener Gig (oft 100–300 CHF in Genf) **kann dein Abo fürs ganze Jahr decken**."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single covered gig (often CHF 100–300 in Geneva) **can pay for your subscription for the year**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo bolo cubierto (a menudo 100–300 CHF en Ginebra) **puede pagar tu suscripción de todo el año**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo concerto coperto (spesso 100–300 CHF a Ginevra) **può ripagare il tuo abbonamento per un anno**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回の代演（ジュネーブでは多くの場合CHF 100〜300）で**年間のサブスク代をまかなえることも**。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需救场一次演出（在日内瓦通常为100–300瑞郎）**就可能抵扣你一整年的订阅费**。"
          }
        }
      }
    },
    "Un tap pour inviter — ils rejoignent l'événement directement.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tipp zum Einladen — sie treten dem Event direkt bei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One tap to invite — they join the event directly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque para invitar: se unen directamente al evento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tocco per invitare: entrano direttamente nell'evento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタップで招待。イベントに直接参加できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一键邀请——他们会直接加入活动。"
          }
        }
      }
    },
    "Une date unique. Les événements qui reviennent sont affichés dans une autre couleur.": {
      "localizations": {
