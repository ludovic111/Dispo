    "Tu organises un SOS ? Accepte ou écarte chaque candidat d'un tap, poste par poste — sans quitter la page" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du organisierst einen SOS? Nimm jeden Kandidaten mit einem Tipp an oder ab, Position für Position – ohne die Seite zu verlassen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hosting an SOS? Accept or turn down each candidate in one tap, slot by slot — without leaving the page"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Organizas un SOS? Acepta o descarta a cada candidato con un toque, puesto a puesto, sin salir de la página"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organizzi un SOS? Accetta o scarta ogni candidato con un tocco, posto per posto — senza lasciare la pagina"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SOS の主催者は、ページを離れずに枠ごとにワンタップで承認・辞退できます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "组织 SOS？逐个位置一键接受或婉拒候选人——无需离开当前页面"
          }
        }
      }
    },
    "Tu peux enfin changer l'heure d'une date déjà créée — même une répétition qui se répète" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst endlich die Uhrzeit eines bereits erstellten Termins ändern — auch bei einer wiederkehrenden Probe"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can finally change the time of a date you already created — even a recurring rehearsal"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por fin puedes cambiar la hora de una fecha ya creada, incluso de un ensayo que se repite"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finalmente puoi cambiare l'orario di una data già creata, anche di una prova ricorrente"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作成済みの日程の時刻を、繰り返しのリハーサルでも変更できるようになりました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你终于可以修改已创建日期的时间了 — 重复排练也可以"
          }
        }
      }
    },
    "Tu peux laisser vide si le lieu n'est pas encore fixé." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst das Feld leer lassen, wenn der Ort noch nicht feststeht."
