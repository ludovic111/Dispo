    },
    "« A joué avec » sur chaque profil : vois avec qui un musicien a déjà joué, et ouvre leurs profils": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Hat gespielt mit“ auf jedem Profil: Sieh, mit wem ein Musiker schon gespielt hat, und öffne ihre Profile"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Has played with” on every profile: see who a musician has played with, and open their profiles"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Ha tocado con» en cada perfil: mira con quién ha tocado un músico y abre sus perfiles"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Ha suonato con» su ogni profilo: vedi con chi ha suonato un musicista e apri i loro profili"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全プロフィールに「共演したメンバー」欄 — 共演相手を確認してプロフィールを開けます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个主页新增「合作过的乐手」：查看合作对象并打开他们的主页"
          }
        }
      }
    },
    "« Cette semaine » inclut les musiciens dispo ce soir et le week-end.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Diese Woche“ umfasst Musiker, die heute Abend und am Wochenende frei sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“This week” includes musicians free tonight and this weekend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Esta semana» incluye a los músicos libres esta noche y el finde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Questa settimana» include i musicisti liberi stasera e nel weekend."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今週」には今夜と週末に空いている人も含まれます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“本周”包含今晚和周末有空的音乐人。"
          }
        }
      }
    },
