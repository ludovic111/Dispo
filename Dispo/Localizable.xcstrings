      }
    },
    "Le leadership ne peut être transmis qu'à un membre Premium." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Leitung kann nur an ein Premium-Mitglied übergeben werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leadership can only be transferred to a Premium member."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El liderazgo solo puede transferirse a un miembro Premium."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La leadership può passare solo a un membro Premium."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リーダーはPremiumメンバーにのみ引き継げます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "队长身份只能转让给Premium成员。"
          }
        }
      }
    },
    "Le leadership ne peut être transmis qu'à un membre Premium. Marque chaque membre Permanent (noyau) ou Occasionnel." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Leitung kann nur an ein Premium-Mitglied übergeben werden. Markiere jedes Mitglied als Permanent (Kern) oder Gelegentlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leadership can only be passed to a Premium member. Mark each member Permanent (core) or Occasional."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El liderazgo solo puede transferirse a un miembro Premium. Marca a cada miembro como Permanente (núcleo) u Ocasional."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La leadership può passare solo a un membro Premium. Segna ogni membro come Permanente (nucleo) oppure Occasionale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リーダー権限はPremiumメンバーにのみ譲渡できます。各メンバーを常任（コア）または臨時に設定しましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "队长身份只能转让给Premium成员。请将每位成员标记为常驻（核心）或临时。"
          }
        }
      }
    },
    "Le leadership peut être transmis à un membre Premium, ou à un membre qui ne dirige encore aucun autre groupe. Marque aussi chacun Permanent (noyau) ou Occasionnel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Leitung kann an ein Premium-Mitglied oder an ein Mitglied übertragen werden, das noch keine andere Gruppe leitet. Kennzeichne außerdem alle als Fest (Kernteam) oder Gelegentlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leadership can be transferred to a Premium member, or to someone who doesn't lead another group yet. Also mark each person as Permanent (core) or Occasional."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El liderazgo puede transferirse a un miembro Premium o a alguien que todavía no dirija otro grupo. Marca también a cada persona como Permanente (núcleo) u Ocasional."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La guida può essere trasferita a un membro Premium o a chi non dirige ancora altri gruppi. Indica inoltre ciascuno come Permanente (nucleo) o Occasionale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リーダー権限は、Premiumメンバーまたは他のグループをまだ率いていないメンバーに引き継げます。各メンバーを「常任（中核）」または「臨時」に設定することもできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "负责人权限可转交给 Premium 成员，或尚未负责其他乐队的成员。你还可以将每位成员标记为常驻（核心）或临时。"
          }
        }
      }
    },
    "Le lien iReal Pro s'ajoute et s'ouvre directement depuis la grille, et la grille se copie d'un tap" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der iReal-Pro-Link wird direkt im Akkordraster hinzugefügt und geöffnet, und das Raster kopiert sich mit einem Tipp"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The iReal Pro link is added and opened straight from the chart, and the chart copies in one tap"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El enlace de iReal Pro se añade y se abre desde la parrilla, y la parrilla se copia con un toque"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il link iReal Pro si aggiunge e si apre dalla griglia, e la griglia si copia con un tocco"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iReal Pro のリンクはコード表から追加・起動でき、コード表はワンタップでコピーできます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
