    "Salut ! Je cherche %@ pour « %@ » le %@ à %@ (cachet : %@). Partant·e ?" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hey! Ich suche %@ für „%@“ am %@ im %@ (Gage: %@). Dabei?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hey! I'm looking for %@ for \"%@\" on %@ at %@ (fee: %@). Interested?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Hola! Busco %@ para «%@» el %@ en %@ (caché: %@). ¿Te apuntas?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciao! Cerco %@ per «%@» il %@ al %@ (compenso: %@). Ci stai?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "こんにちは！「%2$@」（%3$@、%4$@、ギャラ：%5$@）で%1$@を探しています。いかがですか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你好！我在找%@参加《%@》，时间%@，地点%@（酬劳：%@）。有兴趣吗？"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hey! Estou à procura.%@ em \"%@ » ligado%@ para%@ (carimbo:%@). De onde?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안녕하세요! 나는 봐%@ \"에 대한%@ » 에 의해%@ 으로%@ (스탬프:%@). 어디서?"
          }
        }
      }
    },
    "Salut ! On a une place pour « %@ » (%@) le %@ à %@. Tu es dispo — tu nous rejoins ?" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallo! Wir haben einen Platz für „%1$@“ (%2$@) am %3$@ im %4$@. Du bist frei — machst du mit?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi! We have a spot for “%1$@” (%2$@) on %3$@ at %4$@. You're free — will you join us?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Hola! Tenemos un hueco para «%1$@» (%2$@) el %3$@ en %4$@. Estás disponible, ¿te unes?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciao! Abbiamo un posto per «%1$@» (%2$@) il %3$@ al %4$@. Sei libero: ti unisci a noi?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "こんにちは！%3$@に%4$@で「%1$@」（%2$@）の枠があります。空いていますよね——参加しませんか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嗨！%3$@在%4$@的“%1$@”（%2$@）有一个位置。你有空——要加入我们吗？"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hey! Temos um lugar para \"%@ » (%@) ligado%@ para%@. Estás disponível, vais juntar-te a nós?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안녕하세요! 우리는 \"%@ » (%@) 에 의해%@ 으로%@. 당신은 사용할 수 있습니다 - 당신은 우리를 가입?"
          }
        }
      }
    },
