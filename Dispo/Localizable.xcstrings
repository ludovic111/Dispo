      }
    },
    "Un musicien en tournée ou en vacances déclare où il se trouve : avec une date, on cherche ceux qui seront sur place ce jour-là." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer auf Tour oder im Urlaub ist, gibt den Ort an: mit einem Datum findest du, wer an dem Tag dort ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musicians on tour or on holiday say where they are: add a date and you'll find whoever is there that day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien está de gira o de vacaciones indica dónde está: con una fecha, buscas a quien esté allí ese día."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi è in tour o in vacanza indica dove si trova: con una data trovi chi sarà lì quel giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ツアー中や休暇中のミュージシャンは滞在先を登録できます。日付を指定すれば、その日そこにいる人を探せます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "巡演或度假中的音乐人会标明所在地：加上日期，就能找到那天在当地的人。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um músico em turnê ou em férias declara onde está: com uma data, procuramos aqueles que estarão lá naquele dia."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "투어 또는 휴가에 대한 음악가는 그가있는 곳을 선언합니다 : 날짜와, 우리는 그 날에 거기에있는 사람들을 찾습니다."
          }
        }
      }
    },
    "Un musicien précis, à qui tu as demandé de dépanner" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
