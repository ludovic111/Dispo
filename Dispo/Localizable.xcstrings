    "Rien à ton instrument et à ton niveau pour l'instant. Passe sur « Tout » pour voir le reste." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurzeit nichts für dein Instrument und dein Niveau. Wechsle auf „Alle“, um den Rest zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing for your instrument and level right now. Switch to “All” to see the rest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada para tu instrumento y tu nivel por ahora. Cambia a «Todo» para ver el resto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento niente per il tuo strumento e il tuo livello. Passa a «Tutto» per vedere il resto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今はあなたの楽器とレベルに合う募集がありません。「すべて」に切り替えると他も見られます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前没有符合你乐器和水平的招募。切换到“全部”查看其余。"
          }
        }
      }
    },
