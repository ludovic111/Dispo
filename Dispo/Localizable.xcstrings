      }
    },
    "Seul le leader crée les événements — suggère-lui en message." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur der Leader erstellt Events — schlag ihm per Nachricht vor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the leader creates events — suggest one by message."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo el líder crea eventos — sugiérele por mensaje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo il leader crea eventi — suggerisci in chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イベント作成はリーダーのみ。メッセージで提案しましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有队长能创建活动——可以发消息建议。"
          }
        }
      }
    },
    "Seule cette date bouge. Les autres répétitions gardent leur horaire." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur dieser Termin verschiebt sich. Die anderen Proben behalten ihre Uhrzeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only this date moves. The other rehearsals keep their time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se mueve esta fecha. Los demás ensayos mantienen su horario."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sposta solo questa data. Le altre prove mantengono il loro orario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動くのはこの日程だけです。ほかのリハーサルの時刻は変わりません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有这个日期会改动，其他排练时间保持不变。"
          }
        }
      }
    },
    "Seuls les musiciens de ce niveau verront l'annonce dans leur fil." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Musiker dieses Niveaus sehen die Anzeige in ihrem Feed."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only musicians at that level will see the ad in their feed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo los músicos de ese nivel verán el anuncio en su muro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo i musicisti di quel livello vedranno l'annuncio nel loro feed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
