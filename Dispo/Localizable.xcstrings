    "%@ est indispo pour « %@ » — trouve un remplaçant.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist für „%2$@“ nicht verfügbar — finde Ersatz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is unavailable for “%2$@” — find a replacement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no está disponible para «%2$@»: busca un sustituto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ non è disponibile per «%2$@»: trova un sostituto."
