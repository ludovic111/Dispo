    "Paiement débité sur ton compte Apple. L'abonnement se renouvelle automatiquement jusqu'à sa résiliation dans les réglages App Store." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zahlung wird über dein Apple-Konto abgebucht. Das Abo verlängert sich automatisch, bis du es in den App-Store-Einstellungen kündigst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payment is charged to your Apple Account. The subscription renews automatically until canceled in App Store settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pago se carga a tu cuenta de Apple. La suscripción se renueva automáticamente hasta que la canceles en los ajustes de la App Store."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pagamento viene addebitato sul tuo account Apple. L'abbonamento si rinnova automaticamente finché non lo disdici nelle impostazioni dell'App Store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "料金は Apple アカウントに請求されます。App Store の設定で解約するまで、サブスクリプションは自動更新されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
