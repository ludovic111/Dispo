    "Note ton expérience de jeu avec %@ — ta note est anonyme et compte comme « on a joué ensemble ».": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewerte, wie es war, mit %@ zu spielen — deine Note ist anonym und zählt als „wir haben zusammen gespielt“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate your experience playing with %@ — your rating is anonymous and counts as “we played together”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valora tu experiencia tocando con %@ — tu nota es anónima y cuenta como «hemos tocado juntos»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valuta la tua esperienza suonando con %@ — il tuo voto è anonimo e vale come «abbiamo suonato insieme»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@との演奏を評価しよう — 評価は匿名で、「共演した」として記録されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为与%@的合奏体验打分 — 评分匿名，并记录为“我们合作过”。"
          }
        }
      }
    },
