    "Accueil : « Ce soir » devient « Aujourd'hui » — c'est la journée entière qui compte, pas la soirée" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start: „Heute Abend“ wird zu „Heute“ — es zählt der ganze Tag, nicht nur der Abend"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home: “Tonight” becomes “Today” — the whole day counts, not just the evening"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicio: «Esta noche» pasa a ser «Hoy»: cuenta el día entero, no solo la noche"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home: «Stasera» diventa «Oggi»: conta l'intera giornata, non solo la sera"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホーム：「今夜」が「今日」になりました。夜だけでなく一日全体が対象です"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首页：「今晚」改为「今天」— 算的是一整天，而不只是晚上"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
