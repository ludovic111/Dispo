        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 마지막으로 이미 만들어진 날짜의 시간을 변경할 수 있습니다 - 반복적으로 반복"
          }
        }
      }
    },
    "Tu peux laisser vide si le lieu n'est pas encore fixé." : {
      "localizations" : {
