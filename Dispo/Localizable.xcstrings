    "Les groupes deviennent de vrais groupes : leader (Premium), invitations, exclusions, leadership transférable": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppen werden echte Bands: Leader (Premium), Einladungen, Ausschlüsse, übertragbare Leitung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Groups become real bands: leader (Premium), invites, removals, transferable leadership"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los grupos se vuelven bandas de verdad: líder (Premium), invitaciones, expulsiones, liderazgo transferible"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I gruppi diventano vere band: leader (Premium), inviti, esclusioni, leadership trasferibile"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループが本物のバンドに：リーダー（Premium）・招待・除名・リーダー引き継ぎ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "群组变成真正的乐队：队长（Premium）、邀请、移除、可转让队长"
          }
        }
      }
    },
    "Les invitations de groupe s'acceptent : personne n'entre dans un groupe sans dire oui": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppeneinladungen werden angenommen: Niemand tritt einer Gruppe bei, ohne Ja zu sagen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group invitations must be accepted: nobody joins a group without saying yes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las invitaciones de grupo se aceptan: nadie entra a un grupo sin decir que sí"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli inviti ai gruppi vanno accettati: nessuno entra in un gruppo senza dire di sì"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループ招待は承認制に — 同意なしにグループへ入ることはありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小组邀请需经接受：没有人会在未同意的情况下加入小组"
          }
        }
      }
    },
    "Les meilleurs profils en haut, leur niveau affiché.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die besten Profile oben, ihr Level sichtbar."
