      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib die klingende Tonart an (die des Klaviers). Alle sehen ihre eigene: Altsaxofon liest eine große Sexte höher, Trompete einen Ganzton."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the concert key (the piano's). Everyone sees their own: an alto sax reads a major sixth higher, a trumpet a whole tone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica la tonalidad real (la del piano). Cada uno verá la suya: un saxo alto lee una sexta mayor por encima; una trompeta, un tono."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica la tonalità reale (quella del piano). Ognuno vedrà la sua: un sax contralto legge una sesta maggiore sopra, una tromba un tono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実音（ピアノ）の調を入力します。各自の調が表示されます — アルトサックスは長 6 度上、トランペットは長 2 度上。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填写实际调性（钢琴的调）。每人会看到自己的调：中音萨克斯高大六度，小号高大二度。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica o tom real (o piano). Cada membro verá o seu próprio: um saxofone alto lê um sexto major acima, um trompete um tom."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실제 톤 ( 피아노)를 나타냅니다. 각 회원은 자신의 / 그 자체를 볼 수 있습니다 : alto saxophone는 위에 여섯 번째 전공을 읽습니다. trumpet a tone."
          }
        }
      }
    },
