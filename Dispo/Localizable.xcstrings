          }
        }
      }
    },
    "Les partitions du groupe sont maintenant partagées : chaque membre peut les ouvrir, les télécharger et en ajouter": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Noten der Gruppe werden jetzt geteilt: Jedes Mitglied kann sie öffnen, herunterladen und neue hinzufügen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group sheet music is now shared: every member can open, download and add scores"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las partituras del grupo ahora se comparten: cada miembro puede abrirlas, descargarlas y añadir más"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli spartiti del gruppo ora sono condivisi: ogni membro può aprirli, scaricarli e aggiungerne"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
