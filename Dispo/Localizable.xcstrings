        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto per reagire, modificare il testo o eliminare il messaggio per tutti"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
