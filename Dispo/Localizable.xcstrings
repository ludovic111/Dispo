    },
    "Personne n'a encore postulé. Dès qu'un musicien se propose, tu choisiras ici qui prend chaque poste." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Bewerbung. Sobald sich jemand meldet, wählst du hier, wer welche Position übernimmt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nobody has applied yet. As soon as someone offers, you'll pick who takes each slot here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie se ha postulado todavía. En cuanto alguien se ofrezca, elegirás aquí quién ocupa cada puesto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna candidatura per ora. Appena qualcuno si propone, sceglierai qui chi prende ogni posto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ応募はありません。誰かが手を挙げたら、ここで各パートの担当を選べます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有人报名。一旦有人应征，你可以在这里挑选每个位置的人选。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda ninguém se candidatou. Assim que um músico o propor, você vai escolher aqui quem leva todos os empregos."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 적용되지 않았습니다. 뮤지션이 되기 때문에 모든 일을 할 수 있습니다."
          }
        }
      }
    },
    "Personne ne matche pour l'instant. Dès qu'un musicien compatible coche le %@ dans son calendrier, il apparaîtra ici." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
