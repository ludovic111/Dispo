          }
        }
      }
    },
    "Un tap suffit — en face, on sait tout de suite s'il faut chercher quelqu'un d'autre" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Tipp genügt — die andere Seite weiß sofort, ob sie jemand anderen suchen muss"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One tap is enough — the other side knows right away whether to look for someone else"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basta un toque: al otro lado sabrán enseguida si hay que buscar a otra persona"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
