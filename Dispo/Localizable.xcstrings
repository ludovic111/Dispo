    "Premium n'achète ni l'accès au réseau ni ta sécurité." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Premium kaufst du weder den Zugang zum Netzwerk noch deine Sicherheit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium doesn't buy access to the network or your safety."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium no compra ni el acceso a la red ni tu seguridad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium non compra né l'accesso alla rete né la tua sicurezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premiumでネットワークへのアクセスや安全性を買う必要はありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium 不会让网络访问或安全功能变成付费权益。"
          }
        }
      }
    },
    "Premium ne cache plus les niveaux, ne retarde plus les SOS et ne vend jamais une fonction de sécurité" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium verbirgt keine Niveaus mehr, verzögert keine SOS und verkauft niemals eine Sicherheitsfunktion"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium no longer hides levels, delays SOS posts, or puts a safety feature behind a paywall"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premium ya no oculta niveles, retrasa los SOS ni cobra por una función de seguridad"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
