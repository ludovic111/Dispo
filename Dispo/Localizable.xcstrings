    "Remplacement automatique : niveau « peu importe » ou « identique à l'absent », rien de plus à régler" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatischer Ersatz: Niveau „egal“ oder „wie die fehlende Person“ — mehr gibt es nicht einzustellen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic replacement: level “any” or “same as the missing player” — nothing more to set"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustitución automática: nivel «cualquiera» o «igual que el ausente», nada más que ajustar"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituzione automatica: livello «indifferente» o «uguale a chi manca», nulla da regolare"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動代役：レベルは「どれでも」か「欠員と同じ」の2択だけ"
