        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O suporte longo permite reagir, modificar o seu texto ou apagar a sua mensagem para todos"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "긴 지원은 반응 할 수 있으며 텍스트를 수정하거나 모든 사람에게 메시지를 삭제 할 수 있습니다."
