    "Vérifie ta connexion, puis réessaie. Aucun achat ne peut partir tant qu'un prix Apple n'est pas chargé." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe deine Verbindung und versuche es erneut. Solange kein Apple-Preis geladen ist, kann kein Kauf gestartet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check your connection, then try again. No purchase can start until an Apple price has loaded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba tu conexión y vuelve a intentarlo. No se iniciará ninguna compra hasta que se cargue un precio de Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla la connessione e riprova. Nessun acquisto può partire finché non viene caricato un prezzo Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続を確認して、もう一度お試しください。Appleの価格が読み込まれるまで購入は開始されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查网络后重试。在 Apple 价格加载完成前，不会发起任何购买。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique sua conexão e tente novamente. Nenhuma compra pode ir até que um preço da Apple seja cobrado."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결 확인 후 다시 시도하십시오. Apple 가격이 청구 될 때까지 구매가 갈 수 없습니다."
          }
        }
      }
    },
