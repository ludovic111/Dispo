    "Ce qui attend ta réponse passe en tête — tu réponds dispo ou indispo sans quitter l'agenda" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was auf deine Antwort wartet, steht oben — zu- oder absagen ohne den Kalender zu verlassen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whatever's waiting on you comes first — say yes or no without leaving the agenda"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que espera tu respuesta va primero: dices sí o no sin salir de la agenda"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò che attende la tua risposta va in cima — rispondi senza uscire dall'agenda"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返信待ちが最上部に — 予定画面のまま参加可否を回答"
          }
        },
        "zh-Hans" : {
