    "Chaque profil a sa vidéo de démo. Tu entends le niveau et le style — zéro mauvaise surprise.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Profil hat ein Demo-Video. Du hörst Level und Stil — keine bösen Überraschungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every profile has a demo video. You hear the level and style — zero bad surprises."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada perfil tiene su vídeo de demo. Escuchas el nivel y el estilo — cero sorpresas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni profilo ha il suo video demo. Senti livello e stile — zero brutte sorprese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全プロフィールにデモ動画。レベルとスタイルが事前に分かるから安心。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个档案都有演示视频。水平和风格一听便知——绝无意外。"
          }
        }
      }
    },
