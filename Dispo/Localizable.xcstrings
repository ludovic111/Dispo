    "Suis les musiciens fiables : tes amis et abonnés remontent en premier dans tes recherches.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folge zuverlässigen Musikern: Freunde und Follower erscheinen zuerst in deinen Suchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow reliable musicians: your friends and followers rank first in your searches."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue a los músicos fiables: tus amigos y seguidores salen primero en tus búsquedas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui i musicisti affidabili: amici e follower salgono in cima alle tue ricerche."
          }
        },
