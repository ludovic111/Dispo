    "Un événement à qui il manque du monde passe au rouge dès que la date limite de réponse est dépassée" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehlen Leute, wird der Termin rot, sobald die Antwortfrist abgelaufen ist"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An event missing people turns red once the reply deadline has passed"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si falta gente, el evento se pone rojo en cuanto pasa la fecha límite de respuesta"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
