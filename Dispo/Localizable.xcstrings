    "« A joué avec » sur chaque profil : vois avec qui un musicien a déjà joué, et ouvre leurs profils" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Hat gespielt mit“ auf jedem Profil: Sieh, mit wem ein Musiker schon gespielt hat, und öffne ihre Profile"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Has played with” on every profile: see who a musician has played with, and open their profiles"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Ha tocado con» en cada perfil: mira con quién ha tocado un músico y abre sus perfiles"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Ha suonato con» su ogni profilo: vedi con chi ha suonato un musicista e apri i loro profili"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全プロフィールに「共演したメンバー」欄 — 共演相手を確認してプロフィールを開けます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个主页新增「合作过的乐手」：查看合作对象并打开他们的主页"
          }
        }
      }
    },
    "« Cette semaine » inclut les musiciens dispo ce soir et le week-end." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Diese Woche“ umfasst Musiker, die heute Abend und am Wochenende frei sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“This week” includes musicians free tonight and this weekend."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Esta semana» incluye a los músicos libres esta noche y el finde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Questa settimana» include i musicisti liberi stasera e nel weekend."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「今週」には今夜と週末に空いている人も含まれます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“本周”包含今晚和周末有空的音乐人。"
          }
        }
      }
    },
    "« Cherche bassiste samedi, Chat Noir, cachet CHF 150 »" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Bassist für Samstag gesucht, Chat Noir, CHF 150“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Need a bassist Saturday, Chat Noir, CHF 150 fee”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Busco bajista el sábado, Chat Noir, 150 CHF»"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Cerco bassista sabato, Chat Noir, 150 CHF»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「土曜ベーシスト募集、Chat Noir、ギャラCHF 150」"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“周六找贝斯手，Chat Noir，酬劳150瑞郎”"
          }
        }
      }
    },
    "« Demander un dépannage » n'envoie plus un message : c'est une vraie demande, acceptée ou refusée d'un tap" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Einspringen anfragen“ schickt keine Nachricht mehr: Es ist eine echte Anfrage, mit einem Tipp angenommen oder abgelehnt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ask someone to fill in” no longer sends a message: it's a real request, accepted or declined in one tap"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Pedir una sustitución» ya no envía un mensaje: es una solicitud real, aceptada o rechazada con un toque"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Chiedere una sostituzione» non invia più un messaggio: è una vera richiesta, accettata o rifiutata con un tocco"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「代役を頼む」はメッセージではなく本物の依頼に — ワンタップで承諾か辞退"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「请求救场」不再发送消息：这是一个真正的请求，一键接受或婉拒"
          }
        }
      }
    },
    "« Écouter sur… » : les liens ouvrent vraiment Apple Music, Spotify, YouTube Music et Deezer — avec leurs logos" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Anhören auf …“: Die Links öffnen jetzt wirklich Apple Music, Spotify, YouTube Music und Deezer — mit ihren Logos"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Listen on…”: links now truly open Apple Music, Spotify, YouTube Music and Deezer — with their logos"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Escuchar en…»: los enlaces abren de verdad Apple Music, Spotify, YouTube Music y Deezer, con sus logos"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Ascolta su…»: i link aprono davvero Apple Music, Spotify, YouTube Music e Deezer — con i loro loghi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「で聴く…」のリンクが Apple Music・Spotify・YouTube Music・Deezer を正しく開くように — ロゴ付きで"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「在…收听」：链接现在真正打开 Apple Music、Spotify、YouTube Music 和 Deezer，并显示各自的标志"
          }
        }
      }
    },
    "« En train d'écrire… » : tu vois quand ton contact te répond" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Schreibt …“: Du siehst, wenn dein Kontakt antwortet"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Typing…”: see when your contact is replying"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Escribiendo…»: ves cuándo responde tu contacto"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Sta scrivendo…»: vedi quando il tuo contatto risponde"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「入力中…」：相手が返信していることがわかります"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“正在输入…”：查看联系人何时正在回复"
          }
        }
      }
    },
    "« Je joue » quitte l'onglet SOS : les dépannages qu'on te demande se répondent dans Sessions" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ich spiele“ verlässt den SOS-Tab: Anfragen für Einsätze beantwortest du jetzt in „Sessions“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“I'm playing” leaves the SOS tab: the fill-ins you're asked about are answered in Sessions"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Yo toco» sale de la pestaña SOS: las sustituciones que te piden se responden en Sesiones"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Io suono» lascia la scheda SOS: alle sostituzioni che ti chiedono si risponde in Sessioni"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「参加する」はSOSタブから移動しました。頼まれた代役への返事はセッションで行います"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「我要演出」离开 SOS 标签：别人请你救场的邀约在「演出安排」里回复"
          }
        }
      }
    },
    "« Je joue » réunit toutes tes prochaines dates : dépannages acceptés et concerts de tes groupes" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ich spiele“ sammelt alle deine nächsten Termine: zugesagte Einsätze und Konzerte deiner Bands"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“I'm playing” gathers all your upcoming dates: gigs you accepted and your bands' concerts"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Yo toco» reúne todas tus próximas fechas: sustituciones aceptadas y conciertos de tus grupos"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Suono io» raccoglie tutte le tue prossime date: sostituzioni accettate e concerti dei tuoi gruppi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「出演予定」に今後の予定を集約 — 受けた代役も、グループの本番も"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「我要演出」汇总你所有的近期演出：接下的救场和乐队的音乐会"
          }
        }
      }
    },
    "« Prochain événement » en haut de l'accueil, avec le compte à rebours jusqu'au concert" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Nächster Termin“ ganz oben auf der Startseite, mit Countdown bis zum Auftritt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Next event” at the top of the home screen, counting down to the gig"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Próximo evento» en lo alto del inicio, con la cuenta atrás hasta el concierto"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Prossimo evento» in cima alla home, con il conto alla rovescia fino al concerto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホーム上部に「次のイベント」と本番までのカウントダウン"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首页顶部的「下一场活动」，附带到演出的倒计时"
          }
        }
      }
    },
